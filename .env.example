# --- Postgres ---
POSTGRES_USER=vgen
POSTGRES_PASSWORD=vgen
POSTGRES_DB=vgen
# Host port for local DB clients (5432 is often taken by a local Postgres).
POSTGRES_HOST_PORT=5433

# --- Service URLs (inside the docker network) ---
DATABASE_URL=postgres://vgen:vgen@postgres:5432/vgen
REDIS_URL=redis://redis:6379

# --- API ---
DB_MIGRATE_ON_START=true
DB_LOGGING=false
# pretty | json (structured one-line JSON logs)
LOG_FORMAT=pretty
# Render attempts per job (1 = no retry)
RENDER_ATTEMPTS=2
# Max size of one uploaded file, MB
MAX_UPLOAD_MB=80
# Browser origins allowed to call the API directly (comma-separated); the admin uses a proxy
CORS_ORIGINS=
# Installed engines to hide (comma-separated). docker-compose hides the fake dev stub by
# default; `make fake-on` / `make fake-off` toggle it.
# DISABLED_ENGINES=fake

# --- Host ports (change if they clash with other local projects) ---
API_HOST_PORT=3800
ADMIN_HOST_PORT=5173
STUDIO_HOST_PORT=3801

# --- Render workers ---
# Jobs rendered in parallel by one worker process (renders are CPU-bound; keep 1).
WORKER_CONCURRENCY=1

# --- Remotion worker ---
# Shared memory for Chromium; 2gb is safe with 8 GB given to Docker.
REMOTION_SHM_SIZE=2gb
# Chromium tabs per render; empty = Remotion's default (half of the CPU cores).
# With 8 GB for Docker keep it at 4 or below.
REMOTION_CONCURRENCY=4

# --- Production stack (make prod-up) ---
PROD_HOST_PORT=8080
