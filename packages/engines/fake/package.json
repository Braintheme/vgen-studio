{
  "name": "@vgen/engine-fake",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./manifest": {
      "@vgen/source": "./src/manifest/index.ts",
      "types": "./dist/manifest/index.d.ts",
      "default": "./dist/manifest/index.js"
    },
    "./server": {
      "@vgen/source": "./src/server/index.ts",
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@vgen/media": "workspace:*",
    "@vgen/shared": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
