{
  "name": "@vgen/catalog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "@vgen/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./players": {
      "@vgen/source": "./src/players.ts",
      "types": "./dist/players.d.ts",
      "default": "./dist/players.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@vgen/engine-fake": "workspace:*",
    "@vgen/engine-remotion": "workspace:*",
    "@vgen/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "esbuild": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
